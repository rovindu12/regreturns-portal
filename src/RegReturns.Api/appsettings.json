{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Observability": {
    "ConsoleFormat": "json"
  },
  "AllowedHosts": "*",
  "Api": {
    "Swagger": {
      "Enabled": true,
      "ClientId": "regreturns-demo-api"
    },
    "RateLimit": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Idempotency": {
      "RetentionHours": 24,
      "InFlightSeconds": 60,
      "PurgeIntervalMinutes": 60
    }
  }
}
