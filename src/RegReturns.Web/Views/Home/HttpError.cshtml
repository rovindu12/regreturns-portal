@model RegReturns.Web.Models.HttpErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<h1 class="h3">@Model.Title</h1>
<p>@Model.Message</p>
<p>
    If you need help, contact support and quote this reference:
    <code class="user-select-all">@Model.ErrorReference</code> (error @Model.StatusCode)
</p>
<p class="d-flex flex-wrap gap-2">
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to the home page</a>
</p>
