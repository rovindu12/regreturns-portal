@model SignInFailedViewModel
@{
    ViewData["Title"] = "Sign-in failed";
}

<h1 class="h3">We could not sign you in</h1>
<p>@Model.Message</p>
@if (Model.ContactAdministrator)
{
    <p>Please ask your administrator to check your account in the identity service.</p>
}
@if (Model.ErrorReference is not null)
{
    <p>
        If you contact support, quote this error reference:
        <code class="user-select-all">@Model.ErrorReference</code>
    </p>
}
<p class="d-flex flex-wrap gap-2">
    <a class="btn btn-primary" asp-controller="Account" asp-action="SignIn">Try again</a>
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Go to the home page</a>
</p>
