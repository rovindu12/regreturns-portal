@model ReturnFormViewModel
@{
    var form = Model.Form;
    var outcome = form.Outcome;
    ViewData["Title"] = $"{form.ReturnTypeCode} {form.PeriodLabel}";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var findingsOpen = outcome.Errors + outcome.UnjustifiedWarnings;
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Bank returns</a></li>
        <li class="breadcrumb-item active" aria-current="page">@form.ReturnTypeCode @form.PeriodLabel</li>
    </ol>
</nav>

<section class="mb-4">
    <h1 class="h2">@form.ReturnTypeName <span class="text-body-secondary">(@form.ReturnTypeCode)</span></h1>
    <p class="mb-0">
        Period <strong>@form.PeriodLabel</strong>, due @form.DueDate.ToString(ReturnDisplay.DateFormat, culture).
        <span class="badge @ReturnDisplay.BadgeClass(form.Status) ms-1">@ReturnDisplay.Label(form.Status)</span>
    </p>
    <p class="small text-body-secondary mb-0">
        Revision @form.Revision &middot; template version @form.TemplateVersion &middot; started from @ReturnDisplay.Label(form.Source).ToLowerInvariant()
    </p>
</section>

<partial name="_Flash" />

<section aria-labelledby="summary-heading" class="card mb-4">
    <div class="card-body">
        <h2 id="summary-heading" class="h5">Validation</h2>
        @if (!form.IsValidated)
        {
            <p class="mb-2">The values have changed since the last validation. Validate again before the return can be submitted.</p>
        }
        else if (outcome.IsReadyToSubmit)
        {
            <p class="mb-2 text-success-emphasis">@ReturnDisplay.Describe(outcome) A checker can submit this return.</p>
        }
        else
        {
            <p class="mb-2">@ReturnDisplay.Describe(outcome) <a href="#findings">See the findings</a>.</p>
        }
        <ul class="list-inline mb-3 small">
            <li class="list-inline-item"><span class="badge text-bg-danger">@outcome.Errors</span> @(outcome.Errors == 1 ? "error" : "errors")</li>
            <li class="list-inline-item"><span class="badge text-bg-warning">@outcome.Warnings</span> @(outcome.Warnings == 1 ? "warning" : "warnings")</li>
            <li class="list-inline-item"><span class="badge text-bg-secondary">@outcome.UnjustifiedWarnings</span> to justify</li>
        </ul>
        <div class="d-flex flex-wrap gap-2">
            @if (form.CanJustify)
            {
                <form method="post" asp-action="Validate" asp-route-submissionId="@form.SubmissionId">
                    <button type="submit" class="btn btn-outline-primary">Validate</button>
                </form>
            }
            <a class="btn btn-outline-secondary" asp-action="Download" asp-route-obligationId="@form.ObligationId" asp-route-format="xlsx">Download Excel</a>
            <a class="btn btn-outline-secondary" asp-action="Download" asp-route-obligationId="@form.ObligationId" asp-route-format="csv">Download CSV</a>
            @if (form.CanEdit)
            {
                <a class="btn btn-outline-secondary" asp-action="Upload" asp-route-obligationId="@form.ObligationId">Upload a file</a>
            }
        </div>
    </div>
</section>

@if (Model.SaveError is not null)
{
    <div class="alert alert-danger" role="alert">
        @if (Model.IsEditConflict)
        {
            <p class="mb-1">Someone else saved this return after you opened it, so your changes were not saved.</p>
            <p class="mb-0">
                Your entries are shown below. Saving again replaces the other changes;
                <a asp-action="Return" asp-route-submissionId="@form.SubmissionId">reload the return</a> to see them first.
            </p>
        }
        else
        {
            <span>Your changes were not saved. @Model.SaveError</span>
        }
    </div>
}

<section aria-labelledby="values-heading" class="mb-4">
    <h2 id="values-heading" class="h4">Values</h2>
    @if (form.CanEdit)
    {
        <p class="small text-body-secondary">
            Enter numbers without currency symbols, using a full stop for decimals (thousand separators are fine).
            Saving keeps a draft and validates it; blank fields are allowed in a draft.
        </p>
        <form method="post" asp-action="Save" asp-route-submissionId="@form.SubmissionId" data-warn-unsaved novalidate>
            <input type="hidden" name="EditVersion" value="@Model.EditVersion" />
            @foreach (var group in form.Sections)
            {
                <fieldset class="card mb-3">
                    <legend class="card-header h6 mb-0">@group.Name</legend>
                    <div class="card-body">
                        @foreach (var field in group.Fields)
                        {
                            var id = $"field-{field.Code}";
                            var value = Model.ValueOf(field);
                            var hasError = field.Findings.Any(f => f.Severity == Severity.Error);
                            var describedBy = $"{id}-hint" + (field.Findings.Count > 0 ? $" {id}-findings" : string.Empty);
                            var inputClass = hasError ? "form-control is-invalid" : "form-control";
                            <div class="row mb-3">
                                <label for="@id" class="col-md-5 col-form-label">
                                    @field.Label
                                    <span class="d-block small text-body-secondary font-monospace">@field.Code</span>
                                </label>
                                <div class="col-md-7">
                                    @if (field.DataType == FieldDataType.Boolean)
                                    {
                                        var known = FieldValueParser.TryParseBoolean(value, out var flag);
                                        <select id="@id" name="Values[@field.Code]" class="@(hasError ? "form-select is-invalid" : "form-select")"
                                                aria-describedby="@describedBy" aria-invalid="@(hasError ? "true" : null)">
                                            <option value="" selected="@(string.IsNullOrWhiteSpace(value) ? "selected" : null)">Not answered</option>
                                            <option value="Yes" selected="@(known && flag ? "selected" : null)">Yes</option>
                                            <option value="No" selected="@(known && !flag ? "selected" : null)">No</option>
                                            @if (!known && !string.IsNullOrWhiteSpace(value))
                                            {
                                                <option value="@value" selected>@value (not valid)</option>
                                            }
                                        </select>
                                    }
                                    else if (field.DataType == FieldDataType.Date && ReturnDisplay.FitsDatePicker(value))
                                    {
                                        <input id="@id" name="Values[@field.Code]" type="date" class="@inputClass" value="@value"
                                               aria-describedby="@describedBy" aria-invalid="@(hasError ? "true" : null)" />
                                    }
                                    else
                                    {
                                        <input id="@id" name="Values[@field.Code]" type="text" class="@inputClass" value="@value"
                                               inputmode="@ReturnDisplay.InputMode(field.DataType)" autocomplete="off" spellcheck="false"
                                               maxlength="@SubmissionValue.RawValueMaxLength"
                                               aria-describedby="@describedBy" aria-invalid="@(hasError ? "true" : null)" />
                                    }
                                    <div id="@id-hint" class="form-text">@ReturnDisplay.FormatHint(field)</div>
                                    <partial name="_FieldFindings" model="field" />
                                </div>
                            </div>
                        }
                    </div>
                </fieldset>
            }
            <div class="d-flex gap-2 align-items-center">
                <button type="submit" class="btn btn-primary">Save draft</button>
                <span class="small text-body-secondary">Saving also validates the return.</span>
            </div>
        </form>
    }
    else
    {
        <p class="small text-body-secondary">
            @(form.Status == SubmissionStatus.Draft || form.Status == SubmissionStatus.ReturnedForCorrection
                ? "Only a maker of your bank can change the values."
                : "The return is with the Bank of Valoria and can no longer be changed.")
        </p>
        @foreach (var group in form.Sections)
        {
            <div class="card mb-3">
                <h3 class="card-header h6 mb-0">@group.Name</h3>
                <div class="card-body">
                    <dl class="row mb-0">
                        @foreach (var field in group.Fields)
                        {
                            <dt class="col-md-5 fw-normal">
                                @field.Label
                                <span class="d-block small text-body-secondary font-monospace">@field.Code</span>
                            </dt>
                            <dd class="col-md-7">
                                @(string.IsNullOrWhiteSpace(field.Value) ? "Not entered" : field.Value) @field.Unit
                                <partial name="_FieldFindings" model="field" />
                            </dd>
                        }
                    </dl>
                </div>
            </div>
        }
    }
</section>

<section id="findings" aria-labelledby="findings-heading" class="mb-4">
    <h2 id="findings-heading" class="h4">Findings</h2>
    @if (form.Findings.Count == 0)
    {
        <p>@(form.IsValidated ? "Validation found no problems." : "No findings yet. Save or validate the return to check it.")</p>
    }
    else
    {
        <p class="small text-body-secondary">
            Errors must be corrected. Warnings may stand if you explain why the figure is right
            (at least @ValidationFinding.JustificationMinLength characters); a checker cannot submit until every warning is justified.
            @(findingsOpen == 0 ? "Nothing is open." : null)
        </p>
        <ol class="list-group list-group-numbered">
            @foreach (var finding in form.Findings)
            {
                var isError = finding.Severity == Severity.Error;
                <li id="finding-@finding.Id" class="list-group-item">
                    <div class="d-flex flex-wrap gap-2 align-items-baseline">
                        <span class="badge @(isError ? "text-bg-danger" : "text-bg-warning")">@(isError ? "Error" : "Warning")</span>
                        <a href="#field-@finding.FieldCode" class="fw-semibold">@finding.FieldLabel</a>
                        <span class="small text-body-secondary font-monospace">@finding.RuleCode</span>
                    </div>
                    <p class="mb-2 mt-1">@finding.Message</p>
                    @if (!isError)
                    {
                        if (finding.Justification is not null)
                        {
                            <figure class="mb-0 border-start border-3 ps-2">
                                <blockquote class="mb-1">@finding.Justification</blockquote>
                                <figcaption class="small text-body-secondary">
                                    Justified by @(finding.JustifiedBy ?? "a former user")
                                    @(finding.JustifiedAt is { } at ? $"on {at.UtcDateTime.ToString("d MMM yyyy HH:mm", culture)} UTC" : null)
                                </figcaption>
                            </figure>
                        }
                        else if (form.CanJustify)
                        {
                            var failed = Model.JustifyFindingId == finding.Id;
                            var textId = $"justification-{finding.Id}";
                            <form method="post" asp-action="Justify" asp-route-submissionId="@form.SubmissionId" asp-route-findingId="@finding.Id">
                                <label for="@textId" class="form-label small">Why is this figure right?</label>
                                <textarea id="@textId" name="justification" rows="2"
                                          class="@(failed ? "form-control is-invalid" : "form-control")"
                                          minlength="@ValidationFinding.JustificationMinLength" maxlength="@ValidationFinding.JustificationMaxLength"
                                          aria-describedby="@(failed ? $"{textId}-error" : null)" required>@(failed ? Model.JustifyText : null)</textarea>
                                @if (failed)
                                {
                                    <div id="@textId-error" class="invalid-feedback">@Model.JustifyError</div>
                                }
                                <button type="submit" class="btn btn-sm btn-outline-primary mt-2">Save justification</button>
                            </form>
                        }
                        else
                        {
                            <p class="small mb-0 text-warning-emphasis">Not justified.</p>
                        }
                    }
                </li>
            }
        </ol>
    }
</section>

<section aria-labelledby="uploads-heading" class="mb-4">
    <h2 id="uploads-heading" class="h4">Uploaded files</h2>
    @if (form.Uploads.Count == 0)
    {
        <p>No files have been uploaded to this return.</p>
    }
    else
    {
        <p class="small text-body-secondary">Files are kept as evidence of what was loaded. They are never opened by the portal.</p>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th scope="col">File</th>
                        <th scope="col">Size</th>
                        <th scope="col">Revision</th>
                        <th scope="col">Uploaded by</th>
                        <th scope="col">When (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var upload in form.Uploads)
                    {
                        <tr>
                            <td class="text-break">@upload.FileName</td>
                            <td>@ReturnDisplay.FileSize(upload.SizeBytes)</td>
                            <td>@upload.Revision</td>
                            <td>@upload.UploadedBy</td>
                            <td>@upload.UploadedAt.UtcDateTime.ToString("d MMM yyyy HH:mm", culture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/returns.js" asp-append-version="true"></script>
}
