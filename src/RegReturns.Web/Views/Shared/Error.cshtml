@model RegReturns.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<h1 class="h3">Something went wrong</h1>
<p>We could not complete your request. Please try again in a moment.</p>
<p>
    If the problem continues, contact support and quote this error reference:
    <code class="user-select-all">@Model.ErrorReference</code>
</p>
