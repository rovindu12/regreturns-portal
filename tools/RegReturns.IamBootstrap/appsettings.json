{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Observability": {
    "ConsoleFormat": "text"
  },
  "Wso2": {
    "Authority": "https://localhost:9443/",
    "TrustedCaPath": ".certs/regreturns-dev-ca.crt"
  },
  "IamBootstrap": {
    "PortalBaseUrl": "https://localhost:7101/",
    "ApiBaseUrl": "https://localhost:7201/",
    "EnforceMfa": true,
    "MfaAlwaysUsers": [ "approver.mfa" ],
    "EnvFilePath": ".env.generated",
    "DemoApiInstitutionCode": "HLB"
  }
}
