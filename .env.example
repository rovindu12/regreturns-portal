# Copy to .env (git-ignored) and change every value. Never commit real secrets.
# Passwords must not contain single quotes. Generate values with e.g. `openssl rand -base64 24`.

# SQL Server sa password: at least 8 characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Change_Me_Str0ng!

# --- WSO2 Identity Server (docker-compose.yml, scripts/dev-certs.sh) ---
# Public host name of WSO2: the issuer becomes https://<host>:9443/oauth2/token.
WSO2_HOSTNAME=localhost
# Super admin that replaces WSO2's default admin/admin. Used by IamBootstrap; never by the apps.
WSO2_ADMIN_USERNAME=iamadmin
WSO2_ADMIN_PASSWORD=Change_Me_Adm1n!
# SQL login WSO2 uses for its own databases (created by the wso2-db-init job).
WSO2_DB_USERNAME=wso2
WSO2_DB_PASSWORD=Change_Me_Wso2Db!
# Password for the keystores created by scripts/dev-certs.sh.
WSO2_KEYSTORE_PASSWORD=Change_Me_Keyst0re!
# Internal encryption key: exactly 32 hex characters (openssl rand -hex 16).
WSO2_ENCRYPTION_KEY=00000000000000000000000000000000
# Password WSO2's login pages use to call the server, and its SHA-256 (echo -n "<password>" | sha256sum).
WSO2_AUTH_ENDPOINT_PASSWORD=Change_Me_Endp0int!
WSO2_AUTH_ENDPOINT_PASSWORD_SHA256=replace-with-sha256-of-the-password-above

# --- IamBootstrap (tools/RegReturns.IamBootstrap) ---
# Password given to every demo user in WSO2 (at least 12 characters). Shown on the demo page in the hosted demo.
DEMO_USER_PASSWORD=Change_Me_Dem0Users!

# --- Portal and API ---
# HMAC key for the hash-chained audit trail (ADR 0016): base64 of 32 random bytes (openssl rand -base64 32).
# Web and Api must use the same key. scripts/dev-secrets.sh copies it into user-secrets.
AUDIT_HMAC_KEY=replace-with-openssl-rand-base64-32

# --- Advisory insights (ADR 0030, docs/AI-ASSISTANT.md) ---
# Anthropic API key for AI-written insights on the review page. Optional: left empty, fixed rules write every insight
# and nothing leaves the portal. scripts/dev-secrets.sh copies it into the portal's user-secrets (Ai:Anthropic:ApiKey).
ANTHROPIC_API_KEY=

# --- Production server (docker-compose.prod.yml, deploy/regreturns.sh; docs/DEPLOYMENT.md). The local stack ignores
# these. Public host names: each must resolve to the server, and Caddy fetches their certificates from Let's Encrypt.
PORTAL_HOST=regreturns.example.org
API_HOST=api.regreturns.example.org
IAM_HOST=iam.regreturns.example.org
SEQ_HOST=seq.regreturns.example.org
# Administrators' addresses, space-separated CIDRs (e.g. "203.0.113.7/32 2001:db8:1::/48"): the only clients that reach
# the WSO2 console and Seq. Empty admits nobody; reach them over an SSH tunnel instead.
WSO2_ADMIN_ALLOWLIST=
# SQL login of the portal and the API, a member of regreturns_runtime only (deploy/sqlserver/init-app-db.sh).
APP_DB_USERNAME=regreturns_app
APP_DB_PASSWORD=Change_Me_AppDb1!
# Seq's admin password, used on its first start only (sign in at https://<SEQ_HOST> as admin).
SEQ_ADMIN_PASSWORD=Change_Me_Seq1!
# The public demo (ADR 0031): published demo accounts and the nightly reset. false for a deployment that is not a demo.
DEMO_ENABLED=true
# Docker network of Caddy and the apps; the apps believe forwarded headers from it alone. Change it only on a clash.
EDGE_SUBNET=172.30.0.0/24
# Where the images come from: the release workflow pushes ghcr.io/<owner>/regreturns-*:<commit sha>.
REGISTRY=ghcr.io/rovindu12
# Backups (docs/DR-RUNBOOK.md): days kept on the server, and an encrypted off-site copy when both of the others are set:
# an age public key (age-keygen; keep the private key off the server) and an rclone remote and path (rclone config).
BACKUP_RETENTION_DAYS=14
BACKUP_AGE_RECIPIENT=
BACKUP_RCLONE_REMOTE=
